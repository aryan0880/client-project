# Backend Environment Variables
# Copy this file to .env and fill in your values — NEVER commit .env

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/supplier-survey?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-with-a-long-random-secret-string-at-least-64-chars
JWT_EXPIRES_IN=7d

# Email (Resend or Gmail SMTP)
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173
